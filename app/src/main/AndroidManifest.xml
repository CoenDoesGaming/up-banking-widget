<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Allow querying and launching the official Up Bank app on Android 11+ -->
    <queries>
        <package android:name="au.com.up.money" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UpLockWidget">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Trampoline activity that unlocks the screen, refreshes widgets, and opens the Up app -->
        <activity
            android:name=".LaunchUpActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 1. Activity (1x1 Tiny) -->
        <receiver
            android:name=".UpLockTinyWidgetProvider"
            android:exported="true"
            android:label="@string/widget_activity_tiny_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="au.com.up.lockwidget.ACTION_REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/up_lock_tiny_widget_info" />
        </receiver>

        <!-- 2. Activity (2x1 Small) -->
        <receiver
            android:name=".UpLockSmallWidgetProvider"
            android:exported="true"
            android:label="@string/widget_activity_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="au.com.up.lockwidget.ACTION_REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/up_lock_small_widget_info" />
        </receiver>

        <!-- 3. Savers (1x1 Tiny) -->
        <receiver
            android:name=".UpSaversTinyWidgetProvider"
            android:exported="true"
            android:label="@string/widget_savers_tiny_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="au.com.up.lockwidget.ACTION_REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/up_savers_tiny_widget_info" />
        </receiver>

        <!-- 4. Savers (2x1 Small) -->
        <receiver
            android:name=".UpSaversSmallWidgetProvider"
            android:exported="true"
            android:label="@string/widget_savers_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="au.com.up.lockwidget.ACTION_REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/up_savers_small_widget_info" />
        </receiver>

        <!-- 5. Category Tracker (1x1 Tiny) -->
        <receiver
            android:name=".UpCategoryTinyWidgetProvider"
            android:exported="true"
            android:label="@string/widget_category_tiny_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="au.com.up.lockwidget.ACTION_REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/up_category_tiny_widget_info" />
        </receiver>

        <!-- 6. Category Tracker (2x1 Small) -->
        <receiver
            android:name=".UpCategorySmallWidgetProvider"
            android:exported="true"
            android:label="@string/widget_category_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="au.com.up.lockwidget.ACTION_REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/up_category_small_widget_info" />
        </receiver>

    </application>

</manifest>
